# I.STORE production environment template
# Copy to server/.env.production and fill real values.
# Never commit secrets.

NODE_ENV=production
APP_URL=https://store.example.com
API_URL=https://api.example.com
API_PORT=4000

# Managed PostgreSQL — do NOT use embedded Postgres in production
USE_EMBEDDED_POSTGRES=false
DATABASE_URL=postgresql://istore:CHANGE_ME@db.example.com:5432/istore?sslmode=require

# Redis for rate limits / queues (optional but recommended)
REDIS_URL=redis://redis.example.com:6379

# Session + payment webhook secrets (long random strings)
SESSION_SECRET=replace-with-long-random-session-secret
PAYMENT_WEBHOOK_SECRET=replace-with-long-random-webhook-secret

# S3-compatible media storage (required for multi-instance)
S3_ENDPOINT=https://s3.example.com
S3_BUCKET=istore-media
S3_ACCESS_KEY=replace-me
S3_SECRET_KEY=replace-me
S3_PUBLIC_URL=https://cdn.example.com

# Email provider
SMTP_URL=smtps://user:pass@smtp.example.com:465

# Error monitoring (optional)
SENTRY_DSN=

# Payment provider mode: hosted-stub | stripe | adyen (stub only until wired)
PAYMENT_PROVIDER=hosted-stub
