# I.STORE production environment template
# Copy to server/.env.production and fill real values.
# Never commit secrets.
# Production NEVER uses embedded PostgreSQL — DATABASE_URL is required.

NODE_ENV=production
API_PORT=4000
APP_URL=https://store.example.com
API_URL=https://api.example.com

# Managed PostgreSQL (required — fail-fast if missing)
USE_EMBEDDED_POSTGRES=false
DATABASE_URL=postgresql://istore:CHANGE_ME@db.example.com:5432/istore?sslmode=require

# Session + payment secrets (long random strings, required)
SESSION_SECRET=replace-with-long-random-session-secret
PAYMENT_WEBHOOK_SECRET=replace-with-long-random-webhook-secret

# Redis (cache, rate limits, BullMQ). App degrades if unavailable.
REDIS_URL=redis://redis.example.com:6379

# S3-compatible object storage (required for multi-instance media)
S3_ENDPOINT=https://s3.example.com
S3_REGION=auto
S3_BUCKET=istore-media
S3_ACCESS_KEY=replace-me
S3_SECRET_KEY=replace-me
S3_PUBLIC_URL=https://cdn.example.com

# SMTP transactional email
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=replace-me
SMTP_PASSWORD=replace-me
SMTP_FROM="I.STORE <noreply@example.com>"

# Payment provider: stripe | hosted-stub
# Production refuses hosted-stub / fake card payments.
PAYMENT_PROVIDER=stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Optional
SENTRY_DSN=
